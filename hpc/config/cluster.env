# hpc/config/cluster.env — site and project settings, sourced (set -a) by every job and by submit.py.
# submit.py freezes a copy into hpc/logs/<RUN_ID>/config/ so later edits never change a running study.

# ── Slurm ────────────────────────────────────────────────────────────────────
ACCOUNT="${ACCOUNT:-def-CHANGEME}"            # `sshare -U` or `sacctmgr show assoc user=$USER` lists yours
MAIL_TYPE="${MAIL_TYPE:-FAIL}"                # FAIL | END,FAIL | NONE
MAX_REQUEUES="${MAX_REQUEUES:-20}"            # self-requeues per job after reaching the time limit
REQUEUE_SIGNAL_SECS=900                       # USR1 this many seconds before the time limit

# ── Software (Alliance: modules + wheelhouse; see references/alliance-cluster.md) ─
MODULES="StdEnv/2023 python/3.11"             # add e.g. cuda/12.2 arrow/24.0.0 as the project needs
# Extra wheel directory for packages missing from the wheelhouse ($WORK/wheels). Never name it PIP_*: pip reads
# every PIP_<OPTION> environment variable as its own option, and PIP_FIND_LINKS would hide the wheelhouse.
EXTRA_WHEELS="${EXTRA_WHEELS:-}"
SRC_DIRS="lethe evaluation"                   # repository root is included automatically
CODE_HASH_DIRS="lethe evaluation tests hpc"  # code whose content hash goes into run_manifest.json

# ── Storage ──────────────────────────────────────────────────────────────────
# Active work on scratch (fast, purged, not backed up); final results copied to project (backed up).
WORK="${WORK:-${SCRATCH:-$HOME/scratch}/${PROJECT_NAME:-hpc_runs}}"
RESULTS_DEST=""                               # "" = hpc/logs/<RUN_ID>/results (inside the repo on /project)

# ── GPU policy ───────────────────────────────────────────────────────────────
# Every stage must request a GPU unless experiments.json marks it "cpu_only": true.
# Inside the job, run_stage.py refuses to start if no GPU is visible.
GPU_MONITOR_SECS=60                           # nvidia-smi sampling interval (logs/<RUN_ID>/gpu/)

# ── Optional per-run variables available as {NAME} in experiments.json commands ─
PREFLIGHT_MODEL="mock-scripted"

# Model serving. Smoke mode uses mock records and starts no service. For real
# cells set LETHE_LLM_MODE=ollama, install Ollama under OLLAMA_PREFIX, and set
# the two dated/pinned model tags below before the pilot is frozen.
LETHE_LLM_MODE="${LETHE_LLM_MODE:-mock}"
LETHE_MODEL_SMALL="${LETHE_MODEL_SMALL:-CHANGEME-small-model}"
LETHE_MODEL_LARGE="${LETHE_MODEL_LARGE:-CHANGEME-large-model}"
OLLAMA_PREFIX="${OLLAMA_PREFIX:-}"
OLLAMA_MODELS="${OLLAMA_MODELS:-$WORK/models/ollama}"
OLLAMA_NUM_PARALLEL="${OLLAMA_NUM_PARALLEL:-4}"
LETHE_CELL_WORKERS="${LETHE_CELL_WORKERS:-1}"
